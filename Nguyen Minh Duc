            src="https://upload.wikimedia.org/wikipedia/commons/4/42/Ha_Long_2019_taken_by_DJI_FC220.jpg"
            alt="Vịnh Hạ Long">

    </div>


    <!-- PHIM YÊU THÍCH -->

    <div class="container movie-section">

        <h1>NHỮNG BỘ PHIM MÌNH THÍCH</h1>

        <p class="movie-subtitle">
            Ba lựa chọn quen thuộc trong danh sách phim yêu thích
        </p>


        <!-- PHIM 1: HOME ALONE -->

        <div class="movie-card">

            <img
                src="IMG_5764.jpeg"
                alt="Home Alone">

            <div class="movie-info">

                <h2>Home Alone</h2>

                <p>Hài hước · Gia đình</p>

            </div>

        </div>


        <!-- PHIM 2: SPIDER-MAN -->

        <div class="movie-card">

            <img
                src="IMG_5763.jpeg"
                alt="Spider-Man No Way Home">

            <div class="movie-info">

                <h2>Spider-Man: No Way Home</h2>

                <p>Hành động · Siêu anh hùng</p>

            </div>

        </div>


        <!-- PHIM 3: MISSION IMPOSSIBLE -->

        <div class="movie-card">

            <img
                src="IMG_5762.jpeg"
                alt="Mission Impossible Dead Reckoning">

            <div class="movie-info">

                <h2>Mission: Impossible – Dead Reckoning</h2>

                <p>Hành động · Điệp viên</p>

            </div>

        </div>

    </div>


    <!-- TRƯỜNG ĐẠI HỌC MƠ ƯỚC -->

    <div class="container school">

        <h1>NGÔI TRƯỜNG ĐẠI HỌC MƠ ƯỚC</h1>

        <a href="https://mta.edu.vn" target="_blank">

            <h2>Học viện Kỹ thuật Quân sự</h2>

        </a>

        <iframe
            src="https://www.youtube.com/embed/ZooDyDlvRp8"
            title="Giới thiệu Học viện Kỹ thuật Quân sự"
            allowfullscreen>
        </iframe>

    </div>


    <!-- CHÂN TRANG -->

    <footer>

        <h3>NGUYỄN MINH ĐỨC - 12A4</h3>

        <p>THPT Hồng Gai - Quảng Ninh</p>

        <p>© 2026 My Personal Website</p>

    </footer>

</body>

</html>
